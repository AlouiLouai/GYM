# Optional. Without a key the set summary uses a built-in local note instead of Gemini.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Comma-separated model IDs, raced with staggered starts (first good answer wins, a retired or overloaded one is skipped).
# Check https://ai.google.dev/gemini-api/docs/models for current IDs.
GEMINI_MODEL=gemini-3.6-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite
